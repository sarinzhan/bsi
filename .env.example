# Copy to .env (git ignores it) and change the values. Used by docker-compose.yml (local stack only).
# Production values come from Vault, never from this file.

# Postgres superuser (the per-service logins are created by infra/postgres/init/)
POSTGRES_ADMIN_PASSWORD=dev-admin

# The agent's model. No model proxy yet, so this key is passed into each agent container.
ANTHROPIC_API_KEY=
# anthropic (default) or scripted (a fake model: tests the whole chain without a key or cost)
BSI_LLM=anthropic
